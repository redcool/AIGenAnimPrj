# 复制为 config.env 后按本机情况修改（config.env 不入库）
#
# UniMate 仓库位置（只读依赖：本工程不修改它）
UNIMATE_HOME=/path/to/UniMate

# 跑 UniMate 的 Python —— 必须是装好 torch 和 bpy 的那个环境
UNIMATE_PYTHON=/path/to/miniforge3/envs/unimate/bin/python

# 权重目录：相对 UNIMATE_HOME 或绝对路径
#   unimate_uniml3d_f60_v3  : 通用，≤71 关节任意骨架
#   unimate_mixamo_f60_v2   : 人体专用，固定 22 关节 Mixamo 骨架
UNIMATE_EXP=outputs/unimate_mixamo_f60_v2

# 采样结果和 rig 产物的根目录（相对 UNIMATE_HOME）
UNIMATE_SAMPLES=outputs/samples
UNIMATE_RIGS=outputs/rig

# 可选：下游脚本用的 conda 环境名
# CONDA_ENV=unimate
