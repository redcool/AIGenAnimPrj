# 复制为 config.env 后按本机情况修改（config.env 不入库）

# ---- 依赖：UniMate 仓库（只读，本工程不修改它）----
UNIMATE_HOME=/path/to/UniMate

# 跑 UniMate 的 Python —— 必须是装好 torch 和 bpy 的那个环境（Python 3.10）
UNIMATE_PYTHON=/path/to/miniforge3/envs/unimate/bin/python

# ---- 权重和产物：都在本工程里，相对路径按本工程根目录解析 ----
#   models/unimate_uniml3d_f60_v3  : 通用，≤71 关节任意骨架
#   models/unimate_mixamo_f60_v2   : 人体专用，固定 22 关节 Mixamo 骨架
UNIMATE_EXP=models/unimate_mixamo_f60_v2

UNIMATE_SAMPLES=outputs/samples
UNIMATE_RIGS=outputs/rig

# ---- 可选 ----
# 下游 UniMate 脚本用的 conda 环境名
# CONDA_ENV=unimate
# 权重挂在别处（比如共享盘）时可以直接给绝对路径
# UNIMATE_EXP=/mnt/share/unimate/unimate_mixamo_f60_v2
